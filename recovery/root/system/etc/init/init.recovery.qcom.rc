on early-init
    start qseecomd
    start vendor.keymaster-4-0
    start vendor.keymaster-4-1
    start vendor.gatekeeper-1-0

service qseecomd /vendor/bin/qseecomd
    class core
    user root
    group root system
    oneshot

service vendor.keymaster-4-0 /vendor/bin/hw/android.hardware.keymaster@4.0-service-qti
    class hal
    user system
    group system
    oneshot

service vendor.keymaster-4-1 /vendor/bin/hw/android.hardware.keymaster@4.1-service-qti
    class hal
    user system
    group system
    oneshot

service vendor.gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service-qti
    class hal
    user system
    group system
    oneshot